# Provider-agnostic AI config — pick ONE block and fill in the key.

# GitHub Models (free with a GitHub fine-grained PAT with models:read)
AI_BASE_URL=https://models.github.ai/inference
AI_MODEL=openai/gpt-4o
AI_API_KEY=ghp_your_token_here

# OpenAI
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o
#AI_API_KEY=sk-...

# Anthropic (OpenAI-compatible endpoint)
#AI_BASE_URL=https://api.anthropic.com/v1
#AI_MODEL=claude-sonnet-4-5
#AI_API_KEY=sk-ant-...

# Google Gemini
#AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#AI_MODEL=gemini-2.0-flash
#AI_API_KEY=...

# Azure AI Foundry (OpenAI-compatible v1 endpoint; use your deployment name as AI_MODEL)
#AI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
#AI_MODEL=gpt-4o
#AI_API_KEY=your-azure-key

# Ollama (fully local, no key)
#AI_BASE_URL=http://localhost:11434/v1
#AI_MODEL=qwen2.5:14b
#AI_API_KEY=ollama
